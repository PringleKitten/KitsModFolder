function hudShowN()
    local bpm = getPropertyFromClass('backend.Conductor','bpm')
    local beatDur = 60 / bpm
    local tweenTime = beatDur * 0.7

    cancelTweens({'oz1', 'oz2', 'oz3', 'oz4', 'oz5', 'oz6', 'oz7', 'oz8'})

    local alpha = 1
    setNotesAlpha(alpha)

    pran1, pran, oran, oran1 = false, false, false, false
end

function hudHideN()
    local bpm = getPropertyFromClass('backend.Conductor','bpm')
    local beatDur = 60 / bpm
    local tweenTime = beatDur * 0.7

    pran1, pran, oran, oran1 = true, true, true, true
    local pN, oN = kPN and 0 or 1, kON and 0 or 1

    cancelTweens({'oz1', 'oz2', 'oz3', 'oz4', 'oz5', 'oz6', 'oz7', 'oz8'})

    setNotesAlpha(pN, oN)
end

function setNotesAlpha(pAlpha, oAlpha)
    oAlpha = oAlpha or pAlpha
    if insttt then
        for i = 0, 3 do
            setPropertyFromGroup("playerStrums", i, 'alpha', pAlpha)
            setPropertyFromGroup("opponentStrums", i, 'alpha', oAlpha)
        end
    else
        for i = 0, 3 do
            noteTweenAlpha("oz" .. (i + 1), i, oAlpha, tweenTime, "quartInOut")
            noteTweenAlpha("oz" .. (i + 5), i + 4, pAlpha, tweenTime, "quartInOut")
        end
    end
end

function cancelTweens(tweens)
    for _, obj in pairs(tweens) do
        cancelTween(obj)
    end
end